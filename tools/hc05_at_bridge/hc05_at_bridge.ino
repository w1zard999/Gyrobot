// Одноразовая прокладка: переводит HC-05 (AT-режим) на 115200.
// Клонам HC-05 везёт по-разному, поэтому команда стучится на всех типовых
// бодах AT-режима по кругу: 38400 -> 9600 -> 115200. Модуль применит ту,
// на которой его слушали при входе в AT. Питание — от батареи, USB не нужен.
const long BAUDS[] = {38400, 9600, 115200};

void setup() {
}

void loop() {
  static uint8_t i = 0;
  Serial.begin(BAUDS[i % 3]);
  Serial.println(F("AT+UART=115200,0,0"));
  delay(700);
  i++;
}
